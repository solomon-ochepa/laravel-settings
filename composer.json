{
    "name": "solomon-ochepa/laravel-settings",
    "description": "Store settings as key-value pairs in the database.",
    "homepage": "https://github.com/solomon-ochepa/laravel-settings",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel-settings"
    ],
    "authors": [
        {
            "name": "Solomon Ochepa",
            "email": "solomonochepa@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "laravel/framework": ">=12.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.11",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-drift": "^4.1",
        "pestphp/pest-plugin-profanity": "^4.2",
        "pestphp/pest-plugin-laravel": "^4.1",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "classmap": [
            "src/database/migrations"
        ],
        "psr-4": {
            "SolomonOchepa\\Settings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SolomonOchepa\\Settings\\Tests\\": "tests/",
            "SolomonOchepa\\Settings\\Tests\\App\\": "tests/App/app/",
            "SolomonOchepa\\Settings\\Tests\\Database\\Factories\\": "tests/App/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolomonOchepa\\Settings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "SolomonOchepa\\Settings\\Facades\\Settings"
            }
        }
    },
    "scripts": {
        "profanity": "./vendor/bin/pest --profanity",
        "test": "./vendor/bin/pest",
        "coverage": "./vendor/bin/pest --parallel --coverage --min=100",
        "lint": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=512M",
        "doctor": [
            "clear 2>/dev/null; clear 2>/dev/null; true",
            "echo 'Running code analysis...'",
            "@analyse",
            "echo; echo 'Running code linting...'",
            "./vendor/bin/pint --test",
            "echo; echo 'Running profanity tests...'",
            "@profanity",
            "echo; echo 'Running code coverage...'",
            "@coverage"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
